{{ 'landing-page.css' | asset_url | stylesheet_tag }}
{{ 'component-accordion.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign landing = page.metafields.landing
  assign faqs = landing.faqs.value
-%}

{%- if faqs.size > 0 -%}
  <div class="color-{{ section.settings.color_scheme }} gradient" id="faq">
    <div class="landing-faq page-width page-width--narrow section-{{ section.id }}-padding">
      {%- if section.settings.heading != blank -%}
        <h2 class="title {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- for faq in faqs -%}
        <div class="accordion">
          <details
            id="Details-{{ section.id }}-{{ forloop.index }}"
            {% if section.settings.open_first and forloop.first %}
              open
            {% endif %}
          >
            <summary id="Summary-{{ section.id }}-{{ forloop.index }}">
              <h3 class="accordion__title h4">{{ faq.question.value | escape }}</h3>
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </summary>
            <div
              class="accordion__content rte"
              id="Answer-{{ section.id }}-{{ forloop.index }}"
              role="region"
              aria-labelledby="Summary-{{ section.id }}-{{ forloop.index }}"
            >
              {{ faq.answer | metafield_tag }}
            </div>
          </details>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for faq in faqs -%}
          {
            "@type": "Question",
            "name": {{ faq.question.value | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ faq.answer | metafield_text | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- elsif request.design_mode -%}
  <div class="page-width section-{{ section.id }}-padding">
    <p class="landing-placeholder">FAQ: add entries to "Landing: FAQs" on this page.</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Landing: FAQ",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the page's \"Landing: FAQs\" entries as an accordion and adds FAQ structured data for search engines. FAQ entries can be reused across pages."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" }
      ],
      "default": "h1"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first question by default",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Landing: FAQ"
    }
  ]
}
{% endschema %}
