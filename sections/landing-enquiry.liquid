{{ 'landing-page.css' | asset_url | stylesheet_tag }}
{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign landing = page.metafields.landing
  assign form_id = 'LandingEnquiry-' | append: section.id
-%}

{%- if landing.enquiry_form.value == true -%}
  <div class="color-{{ section.settings.color_scheme }} gradient" id="enquiry">
    <div class="contact landing-enquiry page-width page-width--narrow section-{{ section.id }}-padding">
      <h2 class="title title-wrapper--no-top-margin {{ section.settings.heading_size }}">
        {{- landing.enquiry_heading.value | default: section.settings.heading | escape -}}
      </h2>
      {%- if landing.enquiry_text.value != blank -%}
        <p class="landing-enquiry__intro">{{ landing.enquiry_text.value | escape | newline_to_br }}</p>
      {%- endif -%}

      {%- form 'contact', id: form_id, class: 'isolate' -%}
        {%- if form.posted_successfully? -%}
          <h3 class="form-status form-status-list form__message" tabindex="-1" autofocus>
            {{- 'icon-success.svg' | inline_asset_content -}}
            {{ section.settings.success_message | escape }}
          </h3>
        {%- elsif form.errors -%}
          <div class="form__message">
            <h3 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
              {{- 'icon-error.svg' | inline_asset_content -}}
              {{ 'templates.contact.form.error_heading' | t }}
            </h3>
          </div>
          <ul class="form-status-list caption-large" role="list">
            <li>
              <a href="#{{ form_id }}-email" class="link">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </a>
            </li>
          </ul>
        {%- endif -%}

        <input type="hidden" name="contact[Landing page]" value="{{ page.title | escape }}">

        <div class="contact__fields">
          <div class="field">
            <input
              class="field__input"
              autocomplete="name"
              type="text"
              id="{{ form_id }}-name"
              name="contact[{{ 'templates.contact.form.name' | t }}]"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              placeholder="{{ 'templates.contact.form.name' | t }}"
            >
            <label class="field__label" for="{{ form_id }}-name">{{ 'templates.contact.form.name' | t }}</label>
          </div>
          <div class="field field--with-error">
            <input
              autocomplete="email"
              type="email"
              id="{{ form_id }}-email"
              class="field__input"
              name="contact[email]"
              spellcheck="false"
              autocapitalize="off"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              aria-required="true"
              required
              placeholder="{{ 'templates.contact.form.email' | t }}"
            >
            <label class="field__label" for="{{ form_id }}-email">
              {{- 'templates.contact.form.email' | t }}
              <span aria-hidden="true">*</span></label
            >
          </div>
        </div>

        <div class="field">
          <input
            type="tel"
            id="{{ form_id }}-phone"
            class="field__input"
            autocomplete="tel"
            name="contact[{{ 'templates.contact.form.phone' | t }}]"
            value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
            placeholder="{{ 'templates.contact.form.phone' | t }}"
          >
          <label class="field__label" for="{{ form_id }}-phone">{{ 'templates.contact.form.phone' | t }}</label>
        </div>

        {%- if landing.enquiry_event_fields.value == true -%}
          <div class="contact__fields">
            <div class="field">
              <input
                type="date"
                id="{{ form_id }}-date"
                class="field__input"
                name="contact[{{ section.settings.event_date_label | escape }}]"
                placeholder="{{ section.settings.event_date_label | escape }}"
              >
              <label class="field__label" for="{{ form_id }}-date">{{ section.settings.event_date_label | escape }}</label>
            </div>
            <div class="field">
              <input
                type="number"
                min="1"
                inputmode="numeric"
                id="{{ form_id }}-guests"
                class="field__input"
                name="contact[{{ section.settings.guests_label | escape }}]"
                placeholder="{{ section.settings.guests_label | escape }}"
              >
              <label class="field__label" for="{{ form_id }}-guests">{{ section.settings.guests_label | escape }}</label>
            </div>
          </div>
        {%- endif -%}

        <div class="field">
          <textarea
            rows="6"
            id="{{ form_id }}-body"
            class="text-area field__input"
            name="contact[{{ 'templates.contact.form.comment' | t }}]"
            placeholder="{{ 'templates.contact.form.comment' | t }}"
          >
            {{- form.body -}}
          </textarea>
          <label class="form__label field__label" for="{{ form_id }}-body">
            {{- 'templates.contact.form.comment' | t -}}
          </label>
        </div>

        <div class="contact__button">
          <button type="submit" class="button">{{ section.settings.button_label | escape }}</button>
        </div>
      {%- endform -%}
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="page-width section-{{ section.id }}-padding">
    <p class="landing-placeholder">
      Enquiry form: turn on "Landing: Enquiry form" on this page.
    </p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Landing: Enquiry form",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "A contact form for catering and other enquiries, shown when the page has \"Landing: Enquiry form\" turned on. Messages arrive at the store's contact email, tagged with the page title. Link a button to #enquiry to jump here."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading when the page doesn't set one",
      "default": "Send us an enquiry"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "event_date_label",
      "label": "Event date field label",
      "default": "Event date"
    },
    {
      "type": "text",
      "id": "guests_label",
      "label": "Guests field label",
      "default": "Number of guests"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Send enquiry"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks! We've received your enquiry and will be in touch soon."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Landing: Enquiry form"
    }
  ]
}
{% endschema %}
