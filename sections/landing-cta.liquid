{{ 'landing-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign landing = page.metafields.landing
  assign cta_image = landing.cta_image.value
  assign cta_button = landing.cta_button.value
-%}

{%- if landing.cta_heading.value != blank -%}
  <div
    class="landing-cta color-{{ section.settings.color_scheme }} gradient"
    style="--landing-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
  >
    {%- if cta_image != blank -%}
      <div class="landing-cta__media">
        {{
          cta_image
          | image_url: width: 2400
          | image_tag:
            class: 'landing-cta__image',
            sizes: '100vw',
            widths: '375, 750, 1100, 1500, 2000, 2400',
            alt: ''
        }}
      </div>
    {%- endif -%}
    <div class="landing-cta__content page-width section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <h2 class="landing-cta__heading {{ section.settings.heading_size }}">{{ landing.cta_heading.value | escape }}</h2>
      {%- if landing.cta_text.value != blank -%}
        <p class="landing-cta__text">{{ landing.cta_text.value | escape | newline_to_br }}</p>
      {%- endif -%}
      {%- if cta_button.url != blank -%}
        <a href="{% render 'landing-url', url: cta_button.url %}" class="button button--primary">
          {{- cta_button.text | default: section.settings.button_fallback_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="page-width section-{{ section.id }}-padding">
    <p class="landing-placeholder">Call to action: fill in "Landing: CTA heading" on this page.</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Landing: Call to action",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "A closing banner from the page's \"Landing: CTA\" fields (heading, text, button, background image). Hidden when \"Landing: CTA heading\" is empty."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h0"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 90,
      "step": 10,
      "unit": "%",
      "default": 70
    },
    {
      "type": "text",
      "id": "button_fallback_label",
      "label": "Button label when none is set",
      "default": "Shop now"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Landing: Call to action"
    }
  ]
}
{% endschema %}
