{{ 'landing-page.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign landing = page.metafields.landing
  assign spotlight = landing.spotlight_product.value
  assign current_variant = spotlight.selected_or_first_available_variant
  assign product_form_id = 'product-form-' | append: section.id
-%}

{%- if spotlight != blank -%}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width section-{{ section.id }}-padding">
      <div class="landing-spotlight landing-spotlight--media-{{ section.settings.image_position }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <div class="landing-spotlight__media">
          {%- if spotlight.featured_media != blank -%}
            {{
              spotlight.featured_media
              | image_url: width: 1200
              | image_tag:
                class: 'landing-spotlight__image',
                sizes: '(min-width: 990px) 45vw, 100vw',
                widths: '375, 550, 750, 1000, 1200',
                alt: spotlight.featured_media.alt | default: spotlight.title
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        <div class="landing-spotlight__content">
          {%- if section.settings.label != blank -%}
            <p class="landing-spotlight__label caption-with-letter-spacing">{{ section.settings.label | escape }}</p>
          {%- endif -%}
          <h2 class="landing-spotlight__title {{ section.settings.heading_size }}">
            <a href="{{ spotlight.url }}" class="full-unstyled-link">{{ spotlight.title | escape }}</a>
          </h2>
          {% render 'price', product: spotlight, use_variant: true, show_badges: true, price_class: 'price--large' %}

          <div class="landing-spotlight__text rte">
            {%- if landing.spotlight_text.value != blank -%}
              <p>{{ landing.spotlight_text.value | escape | newline_to_br }}</p>
            {%- elsif spotlight.description != blank -%}
              <p>{{ spotlight.description | strip_html | truncatewords: 40 }}</p>
            {%- endif -%}
          </div>

          <product-form class="product-form" data-hide-errors="false" data-section-id="{{ section.id }}">
            <div class="product-form__error-message-wrapper" role="alert" hidden>
              <span class="svg-wrapper">
                {{- 'icon-error.svg' | inline_asset_content -}}
              </span>
              <span class="product-form__error-message"></span>
            </div>

            {%- form 'product',
              spotlight,
              id: product_form_id,
              class: 'form',
              novalidate: 'novalidate',
              data-type: 'add-to-cart-form'
            -%}
              {%- if spotlight.has_only_default_variant -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}">
              {%- else -%}
                <div class="select landing-spotlight__select">
                  <label class="visually-hidden" for="Variant-{{ section.id }}">
                    {{- spotlight.options | join: ' / ' | escape -}}
                  </label>
                  <select id="Variant-{{ section.id }}" class="select__select" name="id">
                    {%- for variant in spotlight.variants -%}
                      <option
                        value="{{ variant.id }}"
                        {% if variant.id == current_variant.id %}
                          selected
                        {% endif %}
                        {% unless variant.available %}
                          disabled
                        {% endunless %}
                      >
                        {{ variant.title | escape }} – {{ variant.price | money | strip_html }}
                        {%- unless variant.available %} ({{ 'products.product.sold_out' | t }}){% endunless -%}
                      </option>
                    {%- endfor -%}
                  </select>
                  <span class="svg-wrapper">
                    {{- 'icon-caret.svg' | inline_asset_content -}}
                  </span>
                </div>
              {%- endif -%}

              <button
                id="ProductSubmitButton-{{ section.id }}"
                type="submit"
                name="add"
                class="product-form__submit button button--full-width button--primary"
                {% unless current_variant.available %}
                  disabled
                {% endunless %}
              >
                <span>
                  {%- if current_variant.available -%}
                    {{ 'products.product.add_to_cart' | t }}
                  {%- else -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- endif -%}
                </span>
                {%- render 'loading-spinner' -%}
              </button>
            {%- endform -%}
          </product-form>

          {%- if section.settings.view_label != blank -%}
            <a href="{{ spotlight.url }}" class="landing-spotlight__more link underlined-link">
              {{- section.settings.view_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="page-width section-{{ section.id }}-padding">
    <p class="landing-placeholder">Spotlight: pick a "Landing: Spotlight" on this page.</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Landing: Spotlight",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Features the page's \"Landing: Spotlight product\" with an add to cart button. Uses \"Landing: Spotlight text\", or the start of the product description."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label above the product name",
      "default": "Our pick"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Product name size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "view_label",
      "label": "Product link label",
      "default": "View product details"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position on desktop",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Landing: Spotlight"
    }
  ]
}
{% endschema %}
